TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
OPERATOR_TOKEN=
OPENROUTER_API_KEY=
MODEL=nvidia/nemotron-3-super-120b-a12b:free
DATABASE_PATH=.runtime/tarang.sqlite3
TELEGRAM_MODE=polling
# Opens isolated fictional demos, NOT the restricted wedding workspace.
PUBLIC_DEMO_ENABLED=false
PUBLIC_URL=
DATABASE_URL=
GNANI_API_KEY=
# Standard catalogue voice; English prototype default, Hindi uses Nalini.
GNANI_VOICE=Kaveri
TARANG_URL=http://127.0.0.1:8766
TIMEZONE=Asia/Kolkata
# Receive-only WhatsApp Cloud API; enable only after agreeing the authorised scope.
WHATSAPP_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Exact sender digits (country code, no +) mapped to separate wedding identifiers.
WHATSAPP_ROUTES={}
# Isolated linked-device group bridge (not the Cloud API direct-message adapter).
WHATSAPP_GROUP_ENABLED=false
WHATSAPP_GROUP_ID=
WHATSAPP_BRIDGE_TOKEN=
TARANG_GROUP_URL=http://127.0.0.1:8766
# Exact group name is used only during dedicated-account pairing/discovery.
WHATSAPP_GROUP_NAME=
# Pine Labs Online sandbox: read-only readiness probe, no live payment execution.
PINE_CLIENT_ID=
PINE_CLIENT_SECRET=
